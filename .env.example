# Token del bot Telegram dedicato (crealo parlando con @BotFather su Telegram)
TELEGRAM_BOT_TOKEN=

# Chiave API Anthropic (Claude) - console.anthropic.com
ANTHROPIC_API_KEY=

# ID numerico del gruppo/canale Telegram autorizzato a inviare contenuti
# (per evitare che chiunque scriva al bot). Lascialo vuoto in fase di test,
# lo script te lo stampa la prima volta che qualcuno scrive.
ALLOWED_CHAT_ID=

# Meta API - Configurazione per pubblicazione automatica su Facebook e Instagram
# Ottenere questi valori da: https://developers.facebook.com/tools/explorer
# Page ID: ID numerico della pagina Facebook (es. 1078382168688068)
META_PAGE_ID=
# Page Access Token: token di lunga durata per la pagina (es. EAAUFq1nGuUs...)
META_PAGE_ACCESS_TOKEN=

# Webhook Meta (opzionale) - alert email sui commenti con parola chiave e
# ringraziamento automatico a chi scrive la parola chiave di condivisione.
# Stringa scelta da te (qualsiasi valore va bene): va inserita anche nel campo
# "Verify Token" quando configuri il webhook su developers.facebook.com > la tua
# app > Webhooks > sottoscrizione Pagina/Instagram, URL di callback
# https://bot.effataitalia.it/webhook/meta
META_WEBHOOK_VERIFY_TOKEN=

# Canale Telegram (opzionale) su cui ripubblicare il post quando si pubblica la
# bozza Facebook da /bozze. Puo' essere @nomeutente (canale pubblico) o l'ID
# numerico (canale privato). Il bot deve essere admin del canale con permesso
# di pubblicare messaggi.
TELEGRAM_CHANNEL_ID=

# WordPress API (opzionale) - crea l'articolo del blog come bozza su WordPress
# URL del sito (es. https://effataitalia.it)
WORDPRESS_URL=
# Username dell'utente WordPress (con permessi di creare articoli)
WORDPRESS_USERNAME=
# Application Password: Utenti > Il tuo profilo > "Password per le applicazioni"
# nel pannello wp-admin (non e' la password normale dell'account)
WORDPRESS_APP_PASSWORD=

# LinkedIn API (opzionale) - pubblicazione automatica sulla pagina aziendale
# Da linkedin.com/developers/apps > la tua app > scheda "Auth"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Deve corrispondere esattamente a un "Redirect URL" autorizzato nella scheda Auth
LINKEDIN_REDIRECT_URI=https://bot.effataitalia.it/auth/linkedin/callback
# Si ottiene visitando /auth/linkedin sulla dashboard e copiando il token mostrato
# a fine autorizzazione. Scade periodicamente (~2 mesi), va rinnovato ripetendo il collegamento.
LINKEDIN_ACCESS_TOKEN=
# ID numerico della pagina aziendale LinkedIn (dal link della dashboard admin,
# es. linkedin.com/company/123213982/admin/... -> 123213982)
LINKEDIN_ORG_ID=

# Email (opzionale) - invio automatico della mail di ringraziamento al sostenitore
# per le adozioni scolastiche (categoria "1"), se il volontario fornisce l'email.
# Usa Gmail SMTP: indirizzo mittente + Password per le app (non la password normale
# dell'account) generata da Impostazioni Google > Sicurezza > Password per le app.
EMAIL_USER=
EMAIL_APP_PASSWORD=
