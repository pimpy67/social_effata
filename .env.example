# Token del bot Telegram dedicato (crealo parlando con @BotFather su Telegram)
TELEGRAM_BOT_TOKEN=

# Chiave API Anthropic (Claude) - console.anthropic.com
ANTHROPIC_API_KEY=

# ID numerico del gruppo/canale Telegram autorizzato a inviare contenuti
# (per evitare che chiunque scriva al bot). Lascialo vuoto in fase di test,
# lo script te lo stampa la prima volta che qualcuno scrive.
ALLOWED_CHAT_ID=

# Meta API - Configurazione per pubblicazione automatica su Facebook e Instagram
# Ottenere questi valori da: https://developers.facebook.com/tools/explorer
# Page ID: ID numerico della pagina Facebook (es. 1078382168688068)
META_PAGE_ID=
# Page Access Token: token di lunga durata per la pagina (es. EAAUFq1nGuUs...)
META_PAGE_ACCESS_TOKEN=

# Canale Telegram (opzionale) su cui ripubblicare il post quando si pubblica la
# bozza Facebook da /bozze. Puo' essere @nomeutente (canale pubblico) o l'ID
# numerico (canale privato). Il bot deve essere admin del canale con permesso
# di pubblicare messaggi.
TELEGRAM_CHANNEL_ID=

# WordPress API (opzionale) - crea l'articolo del blog come bozza su WordPress
# URL del sito (es. https://effataitalia.it)
WORDPRESS_URL=
# Username dell'utente WordPress (con permessi di creare articoli)
WORDPRESS_USERNAME=
# Application Password: Utenti > Il tuo profilo > "Password per le applicazioni"
# nel pannello wp-admin (non e' la password normale dell'account)
WORDPRESS_APP_PASSWORD=
